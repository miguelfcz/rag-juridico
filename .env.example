# ========================================================
# 🛡️ SENTINEL AI — CONFIGURAÇÕES DE AMBIENTE
# ========================================================

# 1. GOOGLE VERTEX AI
# ID do Projeto no Google Cloud (GCP)
GOOGLE_CLOUD_PROJECT=seu-projeto-gcp-aqui
# Região onde os modelos estão habilitados (ex: us-central1 ou southamerica-east1)
GOOGLE_CLOUD_LOCATION=us-central1
# Caminho para o arquivo JSON de Service Account (opcional se usar gcloud CLI)
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# Modelos Vertex AI
VERTEX_LLM_MODEL=gemini-2.5-flash
VERTEX_EMBED_MODEL=text-embedding-004

# 2. QDRANT CLOUD (Cluster Vetorial)
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=sua-api-key-do-qdrant-cloud-aqui
QDRANT_COLLECTION_NAME=normas_bacen_coaf

# 3. POSTGRESQL (Banco Relacional Local via Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_aml
POSTGRES_USER=aml_admin
POSTGRES_PASSWORD=aml_secret_password

# 4. FALKORDB (Banco de Grafo Local via Docker)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=rede_fraude_sentinel
